{
  "title": "App labels",
  "desc": "Learns which apps are work and which are a distraction",
  "icon": "tag",
  "tags": ["tracking", "labels"],
  "program": {
    "initial": "looking",
    "variables": [
      {"name": "chosen", "desc": "the label picked, or jev's"},
      {"name": "chance", "desc": "how sure jev is of its label"}
    ],
    "states": {
      "looking": {"desc": "what's in focus, and whether to ask about it", "every": 0, "do": [{"name": "follow", "desc": "follows what's in focus", "set": {"name": "track.pin", "expr": "None"}}], "next": [{"goto": "guessing", "when": ["track.now is not None", "track.now.track is not False", "track.now.label is None", "track.now.source != 'jev'"], "desc": "not untracked, no label: jev's, once"}, {"goto": "tracking", "when": ["track.now is not None", "track.now.track is None", "track.since >= 1", "track.reask <= time", "not asking"], "desc": "never answered for, a minute in focus"}, {"goto": "labeling", "when": ["track.now is not None", "track.now.track", "track.now.label is None or track.now.source in ('dev', 'jev')", "track.since >= 1", "track.reask <= time", "not asking"], "desc": "tracked, a minute in focus, its label not yours"}, {"goto": "looking", "desc": "nothing to ask"}]},
      "guessing": {"desc": "jev's label, asked once", "every": 0, "do": [{"name": "pin", "desc": "pins it while you're asked", "set": {"name": "track.pin", "expr": "track.now"}}, {"name": "guess", "desc": "asks jev its label", "ask_jev": {"context": {"format": "An app or a website someone uses: {key}", "values": {"key": "track.pin.key"}}, "questions": [{"type": "choice", "question": "What kind of app or website is this?", "criteria": "zip(track.labels.name, track.labels.desc)", "result": "guessed"}]}}, {"name": "keep", "desc": "keeps jev's label", "set": {"name": "chosen", "expr": "track.labels[guessed.index].name"}}, {"name": "keep_odds", "desc": "and how sure it is", "set": {"name": "chance", "expr": "guessed.conf"}}], "next": [{"goto": "guessed", "when": ["guessed is not None"], "desc": "jev answered"}, {"goto": "unguessed", "desc": "no answer"}]},
      "guessed": {"desc": "jev's label kept, for you to confirm", "every": 0, "do": [{"name": "its_label", "desc": "jev's label", "set": {"name": "track.pin.label", "expr": "chosen"}}, {"name": "jevs", "desc": "as jev's", "set": {"name": "track.pin.source", "expr": "'jev'"}}, {"name": "how_sure", "desc": "and how sure", "set": {"name": "track.pin.conf", "expr": "chance"}}], "next": "looking"},
      "unguessed": {"desc": "jev asked, no answer: not asked again", "every": 0, "do": [{"name": "jevs", "desc": "jev's turn, had", "set": {"name": "track.pin.source", "expr": "'jev'"}}], "next": "looking"},
      "tracking": {"desc": "whether to track it", "every": 0, "do": [{"name": "pin", "desc": "pins it while you're asked", "set": {"name": "track.pin", "expr": "track.now"}}, {"name": "track_it", "desc": "asks whether to track it", "ask_usr": {"title": "New app", "context": {"format": "You're using “{key}”, which I haven't track yet. Track it?", "values": {"key": "track.pin.key"}}, "options": ["OK", "Never"], "result": "answer", "timeout": 60}}], "next": [{"goto": "tracked", "when": ["answer == 0"], "desc": "OK"}, {"goto": "untracked", "when": ["answer == 1"], "desc": "never"}, {"goto": "later", "desc": "later"}]},
      "tracked": {"desc": "tracked: its label next", "every": 0, "do": [{"name": "tracked", "desc": "tracked", "set": {"name": "track.pin.track", "expr": "True"}}], "next": "labeling"},
      "untracked": {"desc": "never asked about again", "every": 0, "do": [{"name": "untracked", "desc": "not tracked", "set": {"name": "track.pin.track", "expr": "False"}}], "next": "looking"},
      "labeling": {"desc": "its label, asked as sure as the one it has is", "every": 0, "do": [{"name": "pin", "desc": "pins it while you're asked, if it isn't already (just tracked)", "set": {"name": "track.pin", "expr": "track.now", "when": "track.pin is None"}}, {"name": "label", "desc": "asks its label, the one it has picked already", "ask_usr": {"title": "App label", "context": {"format": "{says}", "values": {"says": "'What is “' + track.pin.key + '”?' if track.pin.label is None else \"I'm pretty sure “\" + track.pin.key + '” is ' + track.pin.label + '. What do you say?' if track.pin.source == 'dev' or track.pin.conf is None or track.pin.conf >= 0.7 else '“' + track.pin.key + '” looks like ' + track.pin.label + ' to me. Is that right?' if track.pin.conf >= 0.4 else '“' + track.pin.key + '” might be ' + track.pin.label + \", but I'm not so sure. What is it?\""}}, "options": "zip(track.labels.name, track.labels.desc)", "result": "answer", "timeout": 60, "default": "track.pin.label"}}, {"name": "keep", "desc": "keeps the label picked", "set": {"name": "chosen", "expr": "track.labels[answer].name"}}], "next": [{"goto": "labeled", "when": ["answer >= 0"], "desc": "a label picked"}, {"goto": "later", "desc": "later"}]},
      "labeled": {"desc": "the label picked, yours", "every": 0, "do": [{"name": "its_label", "desc": "the label picked", "set": {"name": "track.pin.label", "expr": "chosen"}}, {"name": "yours", "desc": "yours: never asked again", "set": {"name": "track.pin.source", "expr": "'usr'"}}], "next": "looking"},
      "later": {"desc": "asked again in two hours", "every": 0, "do": [{"name": "later", "desc": "two hours on", "set": {"name": "track.reask", "expr": "time + 120"}}], "next": "looking"}
    }
  }
}
