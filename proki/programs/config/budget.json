{
  "title": "Busywork check",
  "desc": "Speaks up when small tasks take over a big part of your day",
  "icon": "hourglass",
  "tags": ["focus", "shallow"],
  "variables": [
    {"name": "budget_last_asked", "value": 0, "desc": "when it last asked"}
  ],
  "signals": [
    {"name": "shallow_share", "expr": "shallow_today / (active_today + 0.001)", "desc": "the share of today's time at the computer that was shallow (the day clock counts both)"}
  ],
  "rules": [
    {"name": "budget_workday", "lhs": "weekday", "cmp": "lt", "rhs": 5, "level": 6, "desc": "a weekday"},
    {"name": "budget_not_in_session", "lhs": "session.active", "cmp": "eq", "rhs": 0, "level": 5, "desc": "no session running"},
    {"name": "budget_not_shut_down", "lhs": "shutdown_done", "cmp": "eq", "rhs": 0, "level": 4, "desc": "the day isn't shut down"},
    {"name": "budget_enough_time", "lhs": "active_today", "cmp": "ge", "rhs": 60, "level": 2, "desc": "an hour active today, enough to judge"},
    {"name": "budget_over", "lhs": "shallow_share", "cmp": "gt", "rhs": 0.3, "softness": 0.05, "level": 1, "desc": "shallow work is over 30% of the day"},
    {"name": "budget_not_lately", "lhs": "time - budget_last_asked", "cmp": "ge", "rhs": 30, "level": 7, "desc": "it hasn't asked in the last 30 minutes"}
  ],
  "program": {
    "initial": "idle",
    "states": {
      "idle": {"next": [{"goto": "asking", "when": ["budget_not_lately", "budget_workday", "budget_not_in_session", "budget_not_shut_down", "budget_enough_time", "budget_over"]}]},
      "asking": {"do": [{"name": "budget_last_asked", "desc": "sets budget_last_asked to time", "set": {"name": "budget_last_asked", "expr": "time"}}, {"name": "shallow_work", "desc": "asks “Shallow work”", "ask_usr": {"context": {"format": "Shallow work is at {share:.0%} of your time at the computer today (your limit: 30%). Batch the rest for later, and start a focus session?", "values": {"share": "shallow_share"}}, "options": ["Start session"], "result": "answer", "title": "Shallow work"}}], "every": "6s", "next": [{"goto": "starting", "when": "answer == 0"}, {"goto": "idle"}]},
      "starting": {"do": [{"name": "session_requested", "desc": "sets session.requested to True", "set": {"name": "session.requested", "expr": true}}], "every": "6s"}
    }
  }
}
